NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
WEB_CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://YOUR_OS_USER@localhost/cc?host=/tmp
DATABASE_URL_TEST=postgresql://YOUR_OS_USER@localhost/cc_test?host=/tmp

JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

MAGIC_LINK_EXPIRES_MINUTES=15
MAGIC_TOKEN_SECRET=replace_with_another_64_char_random_hex

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cancionero Católico <no-reply@cancionero.app>"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
